# ═══════════════════════════════════════════════════════════
#  ArtiCRAFT Bot — Environment Variables
#  Ushbu faylni .env nomi bilan nusxa ko'chiring va to'ldiring
# ═══════════════════════════════════════════════════════════

# ─── REJIM ──────────────────────────────────────────────────
# true  = Central server (Telegram + WebSocket server, Minecraft yo'q)
# false = Worker mode (Minecraft bot + Central'ga ulanish)
CENTRAL_MODE=false

# ─── TELEGRAM (faqat CENTRAL_MODE=true da kerak) ────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_IDS=123456789,987654321
TELEGRAM_ENABLED=true
TELEGRAM_FORWARD_CHAT=true

# ─── CENTRAL SERVER (CENTRAL_MODE=true da sozlash) ──────────
CENTRAL_WS_PORT=8765
CENTRAL_HTTP_PORT=8766
# Barcha worker'lar uchun umumiy maxfiy token
CENTRAL_TOKEN=change_this_to_secret_token

# ─── WORKER (CENTRAL_MODE=false da sozlash) ─────────────────
# Ushbu worker'ning noyob ID'si (masalan: replit_bot_1, railway_bot_2)
WORKER_ID=worker_bot_1
# Asosiy serverga ulanish URL (Cloudflare Tunnel yoki to'g'ridan-to'g'ri)
# Misol: wss://xxx.trycloudflare.com yoki ws://your-server.com:8765
CENTRAL_WS_URL=wss://your-tunnel.trycloudflare.com
# HTTP fallback URL (WebSocket ishlamasa)
CENTRAL_HTTP_URL=https://your-tunnel.trycloudflare.com
# Worker xavfsizlik tokeni (CENTRAL_TOKEN bilan bir xil bo'lishi kerak)
WORKER_TOKEN=change_this_to_secret_token
# Worker HTTP health-check porti (Railway/Render/Replit uchun)
WORKER_PORT=3000

# ─── MINECRAFT (CENTRAL_MODE=false da kerak) ────────────────
MC_HOST=articraft.uz
MC_PORT=25565
MC_USERNAME=YourBotUsername
MC_PASSWORD=YourBotPassword
MC_VERSION=1.21.1
# offline | microsoft | mojang
MC_AUTH=offline

# ─── BOT XATTI-HARAKATI ─────────────────────────────────────
AUTO_LOGIN=true
AUTO_RECONNECT=true
RECONNECT_DELAY_MS=5000
# Bot tekshiruvida (bot-check) to'xtatilsinmi?
STOP_ON_BOT_CHECK_KICK=true

# ─── FARMING ────────────────────────────────────────────────
# Vergul bilan ajratilgan yoqilgan ekin turlari
# Mavjud: cocoa,wheat,carrot,potato,beetroot,melon,pumpkin,sugarcane,bamboo
FARMING_CROPS=cocoa,wheat,carrot,potato,beetroot,melon,pumpkin,sugarcane,bamboo

# ─── LOG ────────────────────────────────────────────────────
LOG_LEVEL=info
